#!/bin/sh

if [ -n "${FAKE_ADB_LOG:-}" ]; then
  printf '%s\n' "$*" >> "$FAKE_ADB_LOG"
fi

if [ "${FAKE_ADB_DRAIN_STDIN:-no}" = yes ]; then
  while IFS= read -r ignored_stdin_line; do :; done
fi

if [ "$1" != "-s" ] || [ -z "${2:-}" ]; then
  printf '%s\n' 'fake adb requires -s SERIAL' >&2
  exit 64
fi
fake_serial=$2
shift 2

if [ "$1" = get-state ]; then
  [ "$#" -eq 1 ] || { printf '%s\n' 'invalid fake adb get-state command' >&2; exit 64; }
  if [ "$fake_serial" = network-check:5555 ]; then
    printf '%s\n' "${FAKE_NETWORK_ADB_STATE:-device}"
  else
    printf '%s\n' "${FAKE_ADB_STATE:-device}"
  fi
  exit 0
fi

if [ "$1" = install ]; then
  [ "${2:-}" = -r ] && [ -n "${3:-}" ] && [ -z "${4:-}" ] || {
    printf 'invalid fake adb install command: %s\n' "$*" >&2
    exit 64
  }
  if [ -n "${FAKE_WOLF_STATE:-}" ]; then
    printf '%s\n' '11900120 0.1.9-Wolf' > "$FAKE_WOLF_STATE"
  fi
  printf '%s\n' "${FAKE_WOLF_INSTALL_RESULT:-Success}"
  exit 0
fi

[ "$1" = shell ] || {
  printf '%s\n' 'fake adb supports only install and shell commands' >&2
  exit 64
}
shift

replace_package_state() {
  package=$1
  replacement=$2
  [ -n "${FAKE_PACKAGE_STATE:-}" ] || return 0
  awk -v package="$package" -v replacement="$replacement" '
    $2 == package { if (replacement != "missing") print replacement, package; seen = 1; next }
    { print }
    END { if (!seen && replacement != "missing") print replacement, package }
  ' "$FAKE_PACKAGE_STATE" > "$FAKE_PACKAGE_STATE.next"
  mv "$FAKE_PACKAGE_STATE.next" "$FAKE_PACKAGE_STATE"
}

package_list() {
  list_kind=$1
  if [ -z "${FAKE_PACKAGE_STATE:-}" ]; then
    case "$list_kind" in
      enabled) printf '%s\n' 'package:com.amazon.tv.settings' 'package:com.example.active' ;;
      all) printf '%s\n' 'package:com.amazon.tv.settings' 'package:com.example.active' 'package:com.example.removed' ;;
      disabled) printf '%s\n' 'package:com.example.disabled' ;;
    esac
    return
  fi
  case "$list_kind" in
    enabled)
      awk '$1 == "active" { print "package:" $2 }' "$FAKE_PACKAGE_STATE"
      ;;
    all)
      awk '$1 == "active" || $1 == "disabled" { print "package:" $2 }' "$FAKE_PACKAGE_STATE"
      ;;
    disabled)
      awk '$1 == "disabled" { print "package:" $2 }' "$FAKE_PACKAGE_STATE"
      ;;
  esac
}

settings_route_component() {
  action=$1
  if [ "${FAKE_SETTINGS_ROUTE_ACTION:-}" = "$action" ]; then
    printf '%s\n' "${FAKE_SETTINGS_ROUTE_VALUE:-}"
    return
  fi
  case "$action" in
    android.settings.SETTINGS) printf '%s\n' 'com.amazon.tv.launcher/.ui.SettingsActivity' ;;
    android.settings.WIFI_SETTINGS) printf '%s\n' 'com.amazon.tv.settings.v2/.tv.network.NetworkActivity' ;;
    android.settings.MANAGE_APPLICATIONS_SETTINGS) printf '%s\n' 'com.amazon.tv.settings.v2/.tv.applications.ApplicationsActivity' ;;
    android.settings.CONTROLLERS_SETTINGS) printf '%s\n' 'com.amazon.tv.settings.v2/.tv.controllers_bluetooth_devices.ControllersAndBluetoothActivity' ;;
    android.settings.DEVICE_INFO_SETTINGS) printf '%s\n' 'com.amazon.tv.settings.v2/.tv.device.DeviceActivity' ;;
    android.settings.ACCESSIBILITY_SETTINGS) printf '%s\n' 'com.amazon.tv.settings.v2/.tv.accessibility.AccessibilityActivity' ;;
    android.settings.DISPLAY_SETTINGS) printf '%s\n' 'com.amazon.tv.settings.v2/.tv.display_sounds.DisplayAndSoundsActivity' ;;
    com.amazon.device.settings.action.DATE_TIME) printf '%s\n' 'com.amazon.tv.settings.v2/.tv.preferences.PreferencesActivity' ;;
    com.amazon.device.settings.action.LANGUAGE) printf '%s\n' 'com.amazon.tv.settings.v2/.tv.preferences.LanguageSelectActivity' ;;
    android.settings.APPLICATION_DEVELOPMENT_SETTINGS) printf '%s\n' 'com.amazon.tv.settings.v2/.tv.device.DeviceActivity' ;;
    *) return 1 ;;
  esac
}

settings_route() {
  action=$1
  if [ "$action" != android.intent.action.MAIN ]; then
    if [ -n "${FAKE_AFTER_DISABLE_SETTINGS_ROUTE_ACTION:-}" ] &&
      [ "$FAKE_AFTER_DISABLE_SETTINGS_ROUTE_ACTION" = "$action" ] &&
      [ -n "${FAKE_PACKAGE_STATE:-}" ] &&
      awk '$1 == "disabled" { found=1 } END { exit !found }' "$FAKE_PACKAGE_STATE"
    then
      printf '%s\n' "$FAKE_AFTER_DISABLE_SETTINGS_ROUTE_VALUE"
      return
    fi
    if [ -n "${FAKE_AFTER_ENABLE_SETTINGS_ROUTE_ACTION:-}" ] &&
      [ "$FAKE_AFTER_ENABLE_SETTINGS_ROUTE_ACTION" = "$action" ] &&
      [ -n "${FAKE_PACKAGE_STATE:-}" ] && [ -e "$FAKE_PACKAGE_STATE.enable-occurred" ]
    then
      printf '%s\n' "$FAKE_AFTER_ENABLE_SETTINGS_ROUTE_VALUE"
      return
    fi
    component=$(settings_route_component "$action") || return 1
    if [ "${FAKE_SETTINGS_ROUTES_VERBOSE:-no}" = yes ]; then
      case "$action" in
        android.settings.SETTINGS)
          metadata='priority=100 preferredOrder=0 match=0x108000 specificIndex=-1 isDefault=false'
          ;;
        android.settings.WIFI_SETTINGS)
          metadata='priority=100 preferredOrder=0 match=0x108000 specificIndex=-1 isDefault=false'
          ;;
        *)
          metadata='priority=0 preferredOrder=0 match=0x108000 specificIndex=-1 isDefault=false'
          ;;
      esac
      printf '%s\n%s\n' "$metadata" "$component"
    else
      printf '%s\n' "$component"
    fi
    return
  fi
  case "$action" in
    android.intent.action.MAIN)
      if [ -n "${FAKE_AFTER_DISABLE_HOME_RESOLVER+x}" ] && [ -n "${FAKE_PACKAGE_STATE:-}" ] &&
        awk '$1 == "disabled" { found=1 } END { exit !found }' "$FAKE_PACKAGE_STATE"
      then
        printf '%s\n' "$FAKE_AFTER_DISABLE_HOME_RESOLVER"
      elif [ -n "${FAKE_HOME_RESOLVER+x}" ]; then
        printf '%s\n' "$FAKE_HOME_RESOLVER"
      elif [ "${FAKE_HOME_RESOLVER_VERBOSE:-no}" = yes ]; then
        printf '%s\n' \
          'priority=950 preferredOrder=0 match=0x108000 specificIndex=-1 isDefault=true' \
          'com.amazon.tv.launcher/.ui.HomeActivity_vNext'
      else
        printf '%s\n' 'com.amazon.tv.launcher/.HomeActivity'
      fi
      ;;
    *) return 1 ;;
  esac
}

ui_focus_for_action() {
  case "$1" in
    wolf) printf '%s\n' 'com.wolf.firelauncher/.screens.launcher.LauncherActivity' ;;
    HudActivity) printf '%s\n' 'com.amazon.tv.settings.v2/.hud.HudActivity' ;;
    MainSettingsActivity) printf '%s\n' 'com.amazon.tv.launcher/.ui.MainSettingsActivity' ;;
    PreferencesActivity) printf '%s\n' 'com.amazon.tv.settings.v2/.tv.preferences.PreferencesActivity' ;;
    android.settings.SETTINGS) printf '%s\n' 'com.amazon.tv.launcher/.ui.MainSettingsActivity' ;;
    *) settings_route_component "$1" ;;
  esac
}

write_ui_state() {
  [ -n "${FAKE_UI_STATE:-}" ] || return 0
  printf '%s\n' "$1" > "$FAKE_UI_STATE"
}

read_ui_state() {
  [ -n "${FAKE_UI_STATE:-}" ] && [ -f "$FAKE_UI_STATE" ] || return 1
  cat "$FAKE_UI_STATE"
}

case "$1" in
  getprop)
    if [ "$fake_serial" = network-check:5555 ] && [ "${2:-}" = ro.product.model ] && [ -n "${FAKE_NETWORK_MODEL:-}" ]; then
      value=$FAKE_NETWORK_MODEL
      printf '%s\n' "$value"
      exit 0
    fi
    case "${2:-}" in
      ro.product.manufacturer) value=${FAKE_MANUFACTURER:-Amazon} ;;
      ro.product.model) value=${FAKE_MODEL:-AFTMM} ;;
      ro.product.device) value=${FAKE_DEVICE:-mantis} ;;
      ro.build.id) value=${FAKE_BUILD_ID:-NS6711} ;;
      ro.build.version.incremental) value=${FAKE_INCREMENTAL:-0011644900484} ;;
      ro.build.version.release) value=${FAKE_RELEASE:-7.1.2} ;;
      ro.build.version.sdk) value=${FAKE_SDK:-25} ;;
      ro.product.cpu.abi) value=${FAKE_ABI:-armeabi-v7a} ;;
      ro.serialno) if [ "$fake_serial" = network-check:5555 ]; then value=${FAKE_NETWORK_SERIAL:-fake-serial}; else value=${FAKE_SERIALNO:-fake-serial}; fi ;;
      persist.sys.locale) value=${FAKE_PERSIST_SYS_LOCALE:-en-US} ;;
      system_locales) value=${FAKE_SYSTEM_LOCALES:-en-US} ;;
      persist.sys.usb.config) value=${FAKE_PERSIST_USB_CONFIG:-mtp,adb} ;;
      sys.usb.config) value=${FAKE_SYS_USB_CONFIG:-mtp,adb} ;;
      service.adb.tcp.port) value=${FAKE_SERVICE_ADB_TCP_PORT:-5555} ;;
      persist.adb.tcp.port)
        if [ -n "${FAKE_AFTER_DISABLE_PERSIST_ADB_TCP_PORT+x}" ] && [ -n "${FAKE_PACKAGE_STATE:-}" ] && awk '$1 == "disabled" { found=1 } END { exit !found }' "$FAKE_PACKAGE_STATE"; then
          value=$FAKE_AFTER_DISABLE_PERSIST_ADB_TCP_PORT
        else value=${FAKE_PERSIST_ADB_TCP_PORT-5555}; fi
        ;;
      init.svc.adbd) value=${FAKE_INIT_SVC_ADBD:-running} ;;
      *) value= ;;
    esac
    ;;
  printenv)
    [ "${2:-}" = "HOME" ] || { printf '%s\n' 'fake adb only exposes HOME via printenv' >&2; exit 64; }
    value=${FAKE_HOME:-/data/local/tmp}
    ;;
  settings)
    [ "${2:-}" = "get" ] || { printf '%s\n' 'fake adb only exposes settings get' >&2; exit 64; }
    case "${3:-}:${4:-}" in
      global:bluetooth_on)
        if [ -n "${FAKE_AFTER_ENABLE_BLUETOOTH_ON+x}" ] && [ -n "${FAKE_PACKAGE_STATE:-}" ] &&
          [ -e "$FAKE_PACKAGE_STATE.enable-occurred" ]
        then value=$FAKE_AFTER_ENABLE_BLUETOOTH_ON
        else value=${FAKE_BLUETOOTH_ON:-1}
        fi
        ;;
      global:adb_enabled)
        if [ -n "${FAKE_AFTER_DISABLE_ADB_ENABLED:-}" ] && [ -n "${FAKE_PACKAGE_STATE:-}" ] &&
          awk -v after_count="${FAKE_AFTER_DISABLE_ADB_ENABLED_AFTER_COUNT:-1}" '
            $1 == "disabled" || $1 == "missing" { count++ }
            END { exit !(count >= after_count) }
          ' "$FAKE_PACKAGE_STATE"
        then
          value=$FAKE_AFTER_DISABLE_ADB_ENABLED
        else
          value=${FAKE_ADB_ENABLED:-1}
        fi
        ;;
      global:development_settings_enabled) value=${FAKE_DEVELOPMENT_SETTINGS_ENABLED:-null} ;;
      secure:always_on_vpn_app)
        if [ "${FAKE_ALWAYS_ON_VPN_APP:-}" = none ]; then value=null; else value=${FAKE_ALWAYS_ON_VPN_APP:-com.wireguard.android}; fi
        ;;
      secure:always_on_vpn_lockdown) value=${FAKE_ALWAYS_ON_VPN_LOCKDOWN:-1} ;;
      *) printf 'unsupported fake settings query: %s\n' "$*" >&2; exit 64 ;;
    esac
    ;;
  ip)
    [ "${2:-}" = "link" ] && [ "${3:-}" = "show" ] && [ "${4:-}" = "tun0" ] || {
      printf '%s\n' 'fake adb only exposes ip link show tun0' >&2
      exit 64
    }
    if [ "${FAKE_TUN0:-}" = absent ]; then
      printf '%s\n' 'Cannot find device "tun0"' >&2
      exit 1
    fi
    value=${FAKE_TUN0:-'7: tun0: <POINTOPOINT,NOARP,UP,LOWER_UP>'}
    ;;
  cmd)
    case "${2:-}" in
      package)
        case "${3:-}" in
          help)
            value=${FAKE_CMD_PACKAGE_HELP:-'no supported package state commands'}
            ;;
          resolve-activity)
            action=
            shift 3
            while [ "$#" -gt 0 ]; do
              if [ "$1" = "-a" ]; then
                action=${2:-}
                break
              fi
              shift
            done
            value=$(settings_route "$action") || { printf 'unknown fake resolver action: %s\n' "$action" >&2; exit 64; }
            ;;
          *) printf 'unsupported fake cmd package command: %s\n' "$*" >&2; exit 64 ;;
        esac
        ;;
      *) printf 'unsupported fake cmd command: %s\n' "$*" >&2; exit 64 ;;
    esac
    ;;
  pm)
    case "${2:-}" in
      help)
        if [ -n "${FAKE_PM_HELP+x}" ]; then
          value=$FAKE_PM_HELP
        else
          value='disable-user [--user USER_ID] PACKAGE_OR_COMPONENT
enable [--user USER_ID] PACKAGE_OR_COMPONENT'
        fi
        pm_help_status=${FAKE_PM_HELP_STATUS:-0}
        ;;
      list)
        [ "${3:-}" = "packages" ] || { printf 'unsupported fake pm list: %s\n' "$*" >&2; exit 64; }
        case "${4:-}" in
          ''|-e) value=$(package_list enabled) ;;
          -u) value=$(package_list all) ;;
          -d) value=$(package_list disabled) ;;
          *) printf 'unsupported fake pm list packages flag: %s\n' "${4:-}" >&2; exit 64 ;;
        esac
        ;;
      enable)
        [ "${3:-}" = "--user" ] && [ "${4:-}" = "0" ] && [ -n "${5:-}" ] || {
          printf 'invalid fake pm enable command: %s\n' "$*" >&2
          exit 64
        }
        package=${5}
        if [ "${FAKE_ENABLE_FAIL_PACKAGE:-}" = "$package" ]; then
          printf '%s\n' 'Error: could not enable package'
          exit 1
        fi
        replace_package_state "$package" active
        : > "$FAKE_PACKAGE_STATE.enable-occurred"
        if [ -n "${FAKE_ENABLE_INTERRUPT_MARKER:-}" ]; then
          : > "$FAKE_ENABLE_INTERRUPT_MARKER"
          while [ -e "$FAKE_ENABLE_INTERRUPT_MARKER" ]; do
            sleep 1
          done
        fi
        if [ "${FAKE_ENABLE_ERROR_AFTER_STATE_PACKAGE:-}" = "$package" ]; then
          printf '%s\n' 'Error: enable reported failure after state change'
          exit 1
        fi
        value="Package $package new state: default"
        ;;
      disable-user)
        [ "${3:-}" = "--user" ] && [ "${4:-}" = "0" ] && [ -n "${5:-}" ] || {
          printf 'invalid fake pm disable-user command: %s\n' "$*" >&2
          exit 64
        }
        package=${5}
        if [ "${FAKE_DISABLE_MODE:-}" = error ] || [ "${FAKE_DISABLE_FAIL_PACKAGE:-}" = "$package" ]; then
          printf '%s\n' 'Error: could not disable package'
          exit 1
        fi
        if [ -n "${FAKE_REQUIRED_JOURNAL:-}" ]; then
          grep -Fx "attempt $package" "$FAKE_REQUIRED_JOURNAL" >/dev/null || {
            printf '%s\n' 'disable-user was called before its attempt was journaled' >&2
            exit 1
          }
          if [ "$package" != com.amazon.android.marketplace ] && [ -n "${FAKE_REQUIRED_JOURNAL_RESULT:-}" ]; then
            grep -Fx "$FAKE_REQUIRED_JOURNAL_RESULT" "$FAKE_REQUIRED_JOURNAL" >/dev/null || {
              printf '%s\n' 'next disable-user was called before the previous result was journaled' >&2
              exit 1
            }
          fi
        fi
        case "${FAKE_DISABLE_MODE:-}" in
          still-enabled|silent-no-effect) ;;
          missing-disabled) replace_package_state "$package" missing ;;
          *) replace_package_state "$package" disabled ;;
        esac
        if [ -n "${FAKE_INTERRUPT_MARKER:-}" ]; then
          : > "$FAKE_INTERRUPT_MARKER"
          while [ -e "$FAKE_INTERRUPT_MARKER" ]; do
            sleep 1
          done
        fi
        case "${FAKE_DISABLE_MODE:-}" in
          silent-no-effect) value= ;;
          *) value=${FAKE_DISABLE_RESULT:-"Package $package new state: disabled-user"} ;;
        esac
        ;;
      *) printf 'unsupported fake pm command: %s\n' "$*" >&2; exit 64 ;;
    esac
    ;;
  uname)
    value=${FAKE_UNAME:-armv7l}
    ;;
  getenforce)
    value=${FAKE_ENFORCE:-Enforcing}
    ;;
  id)
    value=${FAKE_UID:-2000}
    ;;
  pidof)
    [ "${2:-}" = adbd ] || { printf 'unsupported fake pidof command: %s\n' "$*" >&2; exit 64; }
    if [ "${FAKE_ADBD_PID:-}" = stopped ]; then value=; else value=${FAKE_ADBD_PID:-123}; fi
    ;;
  netstat)
    [ "${2:-}" = "-ltn" ] || { printf 'unsupported fake netstat command: %s\n' "$*" >&2; exit 64; }
    value=${FAKE_NETSTAT:-'tcp        0      0 0.0.0.0:8009            0.0.0.0:*               LISTEN'}
    ;;
  am)
    if [ "${2:-}" = start ] && [ "${3:-}" = -n ] && [ "${4:-}" = com.wolf.firelauncher/.screens.launcher.LauncherActivity ]; then
      write_ui_state wolf
      value='Starting: Intent { cmp=com.wolf.firelauncher/.screens.launcher.LauncherActivity }'
    elif [ "${2:-}" = start ] && [ "${3:-}" = -n ] && [ "${4:-}" = com.amazon.tv.launcher/.ui.MainSettingsActivity ]; then
      if [ "${FAKE_ROOT_START_RESULT:-success}" = failure ]; then
        printf '%s\n' 'Error: Activity not started' >&2
        exit 1
      fi
      state=$(read_ui_state 2>/dev/null || true)
      case "$state" in protected:*) route=${state#protected:} ;; *) route=android.settings.SETTINGS ;; esac
      write_ui_state "root:$route"
      value='Starting: Intent { cmp=com.amazon.tv.launcher/.ui.MainSettingsActivity }'
    elif [ "${2:-}" = start ] && [ "${3:-}" = -a ] && [ -n "${4:-}" ]; then
      action=${4}
      case "$action" in
        android.settings.SETTINGS|android.settings.ACCESSIBILITY_SETTINGS|android.settings.DISPLAY_SETTINGS|com.amazon.device.settings.action.DATE_TIME|com.amazon.device.settings.action.LANGUAGE)
          if [ "${FAKE_STOCK_MENU_STATUS0_ACTION:-}" = "$action" ]; then
            value="Starting: Intent { act=$action }"
          elif [ "${FAKE_STOCK_MENU_WRONG_ERROR_ACTION:-}" = "$action" ]; then
            printf '%s\n' 'Error: Activity not started' >&2
            exit 1
          else
            write_ui_state "protected:$action"
            printf '%s\n' 'Permission Denial: starting Intent requires com.amazon.tv.permission.LAUNCHER_SETTINGS' >&2
            exit 1
          fi
          ;;
        *)
          settings_route "$action" >/dev/null || { printf 'unknown fake Settings action: %s\n' "$action" >&2; exit 64; }
          write_ui_state "direct:$action"
          value="Starting: Intent { act=$action }"
          ;;
      esac
    else
      printf 'unsupported fake am command: %s\n' "$*" >&2
      exit 64
    fi
    ;;
  input)
    [ "${2:-}" = keyevent ] || { printf 'unsupported fake input command: %s\n' "$*" >&2; exit 64; }
    state=$(read_ui_state 2>/dev/null || true)
    event=${3:-}; [ "$event" != --longpress ] || event="--longpress:${4:-}"
    case "$state" in
      '')
        case "$event" in 176|--longpress:3) write_ui_state hud ;; esac
        ;;
      hud|hud-sequence:*)
        case "$state" in hud) history=$event ;; *) history=${state#hud-sequence:},$event ;; esac
        if [ "$history" = '22,22,22,22,23' ]; then write_ui_state hud-selected; else write_ui_state "hud-sequence:$history"; fi
        ;;
      root:*)
        route=${state#root:}
        case "$event" in 4|3) ;; *) write_ui_state "root-sequence:$route:$event" ;; esac
        ;;
      root-sequence:*)
        route=${state#root-sequence:}; route=${route%%:*}
        history=${state#*:*:}; history="$history,$event"
        case "$route" in
          android.settings.DISPLAY_SETTINGS) expected='20,23' ;;
          android.settings.ACCESSIBILITY_SETTINGS) expected='20,20,22,22,23' ;;
          com.amazon.device.settings.action.DATE_TIME) expected='20,22,22,23' ;;
          com.amazon.device.settings.action.LANGUAGE) expected='20,22,22,23,20,20,20,20,20,20,20,23' ;;
          *) expected=never ;;
        esac
        if [ "$history" = "$expected" ]; then write_ui_state "ready:$route"; else write_ui_state "root-sequence:$route:$history"; fi
        ;;
    esac
    value=
    ;;
  dumpsys)
    if [ "${2:-}" = window ] && [ "${3:-}" = windows ]; then
      state=$(read_ui_state 2>/dev/null || true)
      action=${state#*:}; [ "$state" = wolf ] && action=wolf
      case "$state" in
        ready:*) action=${state#ready:} ;;
        hud|hud-sequence:*) action=HudActivity ;;
        hud-selected) focus=${FAKE_HUD_POST_SELECT_FOCUS:-com.amazon.tv.launcher/.ui.MainSettingsActivity}; action=explicit ;;
        root:*) action=MainSettingsActivity ;;
        root-sequence:*|protected:*) action=wrong ;;
      esac
      case "$state" in
        root-sequence:*:20,22,22,23) action=PreferencesActivity ;;
      esac
      [ "$action" != "$state" ] || action=wolf
      [ "$action" = explicit ] || focus=$(ui_focus_for_action "$action")
      if [ "$action" = MainSettingsActivity ] && [ -n "${FAKE_ROOT_FOCUS:-}" ]; then focus=$FAKE_ROOT_FOCUS; fi
      [ -z "${FAKE_CURRENT_FOCUS:-}" ] || focus=$FAKE_CURRENT_FOCUS
      if [ "$action" = wolf ] && [ -n "${FAKE_WOLF_FOCUS_DELAY_FILE:-}" ]; then
        seen=0; [ -f "$FAKE_WOLF_FOCUS_DELAY_FILE" ] && seen=$(cat "$FAKE_WOLF_FOCUS_DELAY_FILE")
        if [ "$seen" -lt "${FAKE_WOLF_FOCUS_DELAY:-0}" ]; then
          printf '%s\n' $((seen + 1)) > "$FAKE_WOLF_FOCUS_DELAY_FILE"
          focus='com.example/.Loading'
        fi
      fi
      value="mCurrentFocus=Window{0 u0 $focus}"
    else
      [ "${2:-}" = package ] && [ "${3:-}" = com.wolf.firelauncher ] || {
        printf 'unsupported fake dumpsys command: %s\n' "$*" >&2
        exit 64
      }
      if [ -n "${FAKE_WOLF_STATE:-}" ] && [ -f "$FAKE_WOLF_STATE" ]; then
        read -r wolf_version_code wolf_version_name < "$FAKE_WOLF_STATE"
      else
        wolf_version_code=${FAKE_WOLF_INSTALLED_VERSION_CODE:-11723945}
        wolf_version_name=${FAKE_WOLF_INSTALLED_VERSION_NAME:-0.1.7-FireTV}
      fi
      if [ "${FAKE_WOLF_DUMPSYS_INDENT:-no}" = yes ]; then
        value="    versionCode=$wolf_version_code minSdk=21 targetSdk=29
    versionName=$wolf_version_name"
      else
        value="versionCode=$wolf_version_code minSdk=21 targetSdk=29
versionName=$wolf_version_name"
      fi
    fi
    ;;
  uiautomator)
    [ "${2:-}" = dump ] && [ "${3:-}" = /sdcard/mantis-ui-smoke.xml ] || { printf 'unsupported fake uiautomator command: %s\n' "$*" >&2; exit 64; }
    value='UI hierchary dumped to: /sdcard/mantis-ui-smoke.xml'
    ;;
  cat)
    [ "${2:-}" = /sdcard/mantis-ui-smoke.xml ] || { printf 'unsupported fake cat command: %s\n' "$*" >&2; exit 64; }
    state=$(read_ui_state 2>/dev/null || true)
    action=${state#*:}
    case "$state" in
      hud|hud-sequence:*)
        case "${FAKE_HUD_SETTINGS_TILE:-valid}" in
          missing) value='<hierarchy><node text="Profiles" resource-id="com.amazon.tv.settings.v2:id/hud_profiles_button" enabled="true" focusable="true" focused="true" clickable="true" /></hierarchy>' ;;
          nonclickable) value='<hierarchy><node text="Settings" resource-id="com.amazon.tv.settings.v2:id/hud_settings_button" enabled="true" focusable="true" clickable="false" /></hierarchy>' ;;
          *) value='<hierarchy><node text="Profiles" resource-id="com.amazon.tv.settings.v2:id/hud_profiles_button" enabled="true" focusable="true" focused="true" clickable="true" /><node text="Settings" resource-id="com.amazon.tv.settings.v2:id/hud_settings_button" enabled="true" focusable="true" focused="false" clickable="true" /></hierarchy>' ;;
        esac
        ;;
      *)
        if [ "$action" = "${FAKE_UI_EMPTY_ACTION:-}" ]; then value='<hierarchy></hierarchy>'; else value='<hierarchy><node text="Settings" /></hierarchy>'; fi
        ;;
    esac
    ;;
  rm)
    [ "${2:-}" = -f ] && [ "${3:-}" = /sdcard/mantis-ui-smoke.xml ] || { printf 'unsupported fake rm command: %s\n' "$*" >&2; exit 64; }
    value=
    ;;
  *)
    printf 'unsupported fake adb shell command: %s\n' "$*" >&2
    exit 64
    ;;
esac

printf '%s\n' "$value"
exit "${pm_help_status:-0}"
